# Example only. Never commit real values.
PORT=3100
# Cookie session verification target (ivrm-web API)
IVRM_API_BASE_URL=https://api.ivrm.jp
# Bedrock
AWS_REGION=ap-northeast-1
# Cost gate kill switch: set to "true" to refuse every model call
AI_KILL_SWITCH=false
# Postgres (ai-dedicated). Migrations are applied by `pnpm db:migrate`, never at server start.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/ivrm_ai
# Optional: a throwaway database (name must contain "test") enables the Postgres tests.
# TEST_DATABASE_URL=postgres://postgres:test@localhost:5432/ivrm_ai_test
